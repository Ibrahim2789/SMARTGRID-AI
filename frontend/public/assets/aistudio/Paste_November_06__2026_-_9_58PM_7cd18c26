## 2. Global Navigation Chrome Component: `SmartGridNav.tsx`

```tsx
import React, { useState } from 'react';
import { Compass, Sparkles, Menu, X, ChevronDown } from 'lucide-react';

interface SmartGridNavProps {
  activeRoute?: 'solutions' | 'adaptive-engine' | 'student-voice' | 'generator' | 'timetable';
  onNavigate?: (route: string) => void;
}

export const SmartGridNav: React.FC<SmartGridNavProps> = ({ 
  activeRoute = 'solutions',
  onNavigate 
}) => {
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [moreDropdownOpen, setMoreDropdownOpen] = useState(false);

  return (
    <header className="sticky top-0 z-50 bg-[#fbf8fc]/90 backdrop-blur-md border-b border-[#ece6ed] px-8 py-5 transition-all">
      <div className="max-w-7xl mx-auto flex items-center justify-between">
        {/* Brand Wordmark (Cleaned: No subtitle) */}
        <div 
          className="flex items-center gap-3 cursor-pointer select-none"
          onClick={() => onNavigate?.('solutions')}
        >
          <div className="w-9 h-9 rounded-xl bg-[#3b1e4a] flex items-center justify-center text-white shadow-sm">
            <Compass className="w-5 h-5 text-[#f27438]" />
          </div>
          <span className="font-bold text-lg tracking-tight text-[#1f1b20] leading-none whitespace-nowrap">
            SMARTGRID <span className="text-[#f27438]">AI</span>
          </span>
        </div>

        {/* Desktop Single-Line Links (32px / gap-8 spacing, subtle active underline) */}
        <nav className="hidden md:flex items-center gap-8 text-sm font-medium text-[#655d69] whitespace-nowrap">
          <button 
            onClick={() => onNavigate?.('solutions')}
            className={`transition-colors whitespace-nowrap pb-1 ${
              activeRoute === 'solutions' 
                ? 'text-[#3b1e4a] font-semibold border-b-2 border-[#3b1e4a]' 
                : 'hover:text-[#1f1b20]'
            }`}
          >
            Solutions
          </button>
          <button 
            onClick={() => onNavigate?.('adaptive-engine')}
            className={`transition-colors whitespace-nowrap pb-1 ${
              activeRoute === 'adaptive-engine' 
                ? 'text-[#3b1e4a] font-semibold border-b-2 border-[#3b1e4a]' 
                : 'hover:text-[#1f1b20]'
            }`}
          >
            Adaptive Engine
          </button>
          <button 
            onClick={() => onNavigate?.('student-voice')}
            className={`transition-colors whitespace-nowrap pb-1 ${
              activeRoute === 'student-voice' 
                ? 'text-[#3b1e4a] font-semibold border-b-2 border-[#3b1e4a]' 
                : 'hover:text-[#1f1b20]'
            }`}
          >
            Student Voice
          </button>

          {/* More Dropdown */}
          <div className="relative">
            <button 
              onClick={() => setMoreDropdownOpen(!moreDropdownOpen)}
              className="flex items-center gap-1.5 hover:text-[#1f1b20] transition-colors whitespace-nowrap pb-1"
            >
              <span>More</span>
              <ChevronDown className="w-3.5 h-3.5 text-[#7c747f]" />
            </button>

            {moreDropdownOpen && (
              <div className="absolute top-full left-0 mt-2 w-52 bg-white border border-[#ece6ed] rounded-xl shadow-lg py-2 z-50">
                <button
                  onClick={() => { onNavigate?.('timetable'); setMoreDropdownOpen(false); }}
                  className="w-full text-left px-4 py-2.5 text-xs font-semibold text-[#1f1b20] hover:bg-[#f6f2f7] transition-colors"
                >
                  Timetable Matrix
                </button>
                <button
                  onClick={() => { onNavigate?.('generator'); setMoreDropdownOpen(false); }}
                  className="w-full text-left px-4 py-2.5 text-xs font-semibold text-[#1f1b20] hover:bg-[#f6f2f7] transition-colors"
                >
                  Generator Studio
                </button>
                <button
                  onClick={() => { setMoreDropdownOpen(false); }}
                  className="w-full text-left px-4 py-2.5 text-xs font-semibold text-[#655d69] hover:bg-[#f6f2f7] transition-colors"
                >
                  Institutional Case Studies
                </button>
              </div>
            )}
          </div>
        </nav>

        {/* Consolidated Right Actions: 1 Text Link + 1 Primary Button with rounded-xl */}
        <div className="hidden md:flex items-center gap-6">
          <button className="text-xs font-semibold uppercase tracking-wider text-[#3b1e4a] hover:text-[#f27438] transition-colors whitespace-nowrap">
