      {/* Mobile Drawer */}
      {mobileMenuOpen && (
        <div className="md:hidden pt-4 pb-2 border-t border-[#ece6ed] mt-4 space-y-3">
          <button 
            onClick={() => { onNavigate?.('solutions'); setMobileMenuOpen(false); }}
            className="block w-full text-left text-sm font-semibold text-[#1f1b20] py-2"
          >
            Solutions
          </button>
          <button 
            onClick={() => { onNavigate?.('adaptive-engine'); setMobileMenuOpen(false); }}
            className="block w-full text-left text-sm font-semibold text-[#1f1b20] py-2"
          >
            Adaptive Engine
          </button>
          <button 
            onClick={() => { onNavigate?.('student-voice'); setMobileMenuOpen(false); }}
            className="block w-full text-left text-sm font-semibold text-[#1f1b20] py-2"
          >
            Student Voice
          </button>
          <button 
            onClick={() => { onNavigate?.('timetable'); setMobileMenuOpen(false); }}
            className="block w-full text-left text-sm font-semibold text-[#1f1b20] py-2"
          >
            Timetable Matrix
          </button>
          <div className="pt-2 flex flex-col gap-2">
            <button className="w-full text-center py-2.5 text-xs font-semibold uppercase tracking-wider text-[#3b1e4a] border border-[#ece6ed] rounded-xl">
