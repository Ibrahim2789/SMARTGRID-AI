# =========================================================
# SmartGrid AI — Environment Configuration (.env.example)
# Copy this file to .env and populate with your credentials
# =========================================================

# Application & Server Settings
APP_NAME="SmartGrid AI Multi-University API"
APP_ENV=development
PYTHON_BACKEND_HOST=127.0.0.1
PYTHON_BACKEND_PORT=8001

# Supabase PostgreSQL Configuration
# Obtain these values from your Supabase Project Dashboard -> Project Settings -> API / Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# JWT & Authentication Security
SMARTGRID_AUTH_SECRET=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend API Configuration
VITE_API_BASE_URL=/api

# Custom AI Timetable Optimization Hyperparameters
GA_POPULATION_SIZE=24
GA_GENERATIONS=40
GA_MUTATION_RATE=0.18
GA_CROSSOVER_RATE=0.85
SA_INITIAL_TEMPERATURE=120.0
SA_COOLING_RATE=0.92
SA_ITERATIONS=80
TABU_TENURE=7
TABU_MAX_ITERATIONS=45
